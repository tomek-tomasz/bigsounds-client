<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.bigsoundsclient.ui.tabs.HistoryController"
      spacing="12" style="-fx-background-color: #f0f2f5;">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Historia streamów"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>

    <HBox fx:id="paginationBar" spacing="8" alignment="CENTER_LEFT"/>

    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" prefHeight="540"
               style="-fx-background-color: white; -fx-border-color: #dde1e7;
                      -fx-border-radius: 8; -fx-background-radius: 8;"/>
</VBox>
