<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bigsoundsclient.MainController"
            style="-fx-background-color: #f0f2f5;">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: white; -fx-border-color: #dde1e7; -fx-border-width: 0 0 1 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Label text="🎵 BigSounds"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1db954;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" text=""
                   style="-fx-text-fill: #555; -fx-font-size: 13px;"/>
            <Button text="Wyloguj" onAction="#handleLogout"
                    style="-fx-background-color: #f8f9fa; -fx-text-fill: #333;
                           -fx-border-color: #ced4da; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: #f0f2f5; -fx-tab-min-width: 90px;">

            <!-- SONGS -->
            <Tab text="Utwory">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <VBox spacing="12">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="Utwory"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Button fx:id="refreshSongsBtn" text="⟳  Odśwież" onAction="#loadSongs"
                                    style="-fx-background-color: #1db954; -fx-text-fill: white;
                                           -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-padding: 7 16 7 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </HBox>
                        <TableView fx:id="songsTable" prefHeight="520"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- RELEASES -->
            <Tab text="Wydania">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <VBox spacing="12">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="Wydania"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Button fx:id="refreshReleasesBtn" text="⟳  Odśwież" onAction="#loadReleases"
                                    style="-fx-background-color: #1db954; -fx-text-fill: white;
                                           -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-padding: 7 16 7 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </HBox>
                        <TableView fx:id="releasesTable" prefHeight="520"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ARTISTS -->
            <Tab text="Artyści">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <VBox spacing="12">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="Artyści"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Button fx:id="refreshArtistsBtn" text="⟳  Odśwież" onAction="#loadArtists"
                                    style="-fx-background-color: #1db954; -fx-text-fill: white;
                                           -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-padding: 7 16 7 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </HBox>
                        <TableView fx:id="artistsTable" prefHeight="520"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- PLAYLISTS -->
            <Tab text="Playlisty">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <VBox spacing="12">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="Moje Playlisty"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              style="-fx-background-color: white; -fx-background-radius: 8;
                                     -fx-border-color: #dde1e7; -fx-border-radius: 8; -fx-padding: 12;">
                            <TextField fx:id="newPlaylistName" promptText="Nazwa nowej playlisty" prefWidth="240"
                                       style="-fx-background-color: #f8f9fa; -fx-text-fill: #222;
                                              -fx-prompt-text-fill: #aaa; -fx-border-color: #ced4da;
                                              -fx-border-radius: 6; -fx-background-radius: 6;
                                              -fx-padding: 7 12 7 12; -fx-font-size: 13px;"/>
                            <CheckBox fx:id="newPlaylistPrivate" text="Prywatna"
                                      style="-fx-text-fill: #333; -fx-font-size: 13px;"/>
                            <Button fx:id="createPlaylistBtn" text="+ Utwórz" onAction="#createPlaylist"
                                    style="-fx-background-color: #1db954; -fx-text-fill: white; -fx-font-weight: bold;
                                           -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-padding: 7 18 7 18; -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button fx:id="refreshPlaylistsBtn" text="⟳  Odśwież" onAction="#loadPlaylists"
                                    style="-fx-background-color: #f8f9fa; -fx-text-fill: #333;
                                           -fx-border-color: #ced4da; -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-padding: 7 16 7 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </HBox>
                        <TableView fx:id="playlistsTable" prefHeight="360"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                        <Label fx:id="playlistSongsLabel" text=""
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1db954;"/>
                        <TableView fx:id="playlistSongsTable" prefHeight="200"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"
                                   visible="false" managed="false"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- LIKES -->
            <Tab text="Polubienia">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <VBox spacing="12">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="Polubienia"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <HBox spacing="8">
                            <Button fx:id="refreshLikesBtn" text="⟳  Odśwież" onAction="#loadLikes"
                                    style="-fx-background-color: #1db954; -fx-text-fill: white;
                                           -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-padding: 7 16 7 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </HBox>
                        <Label text="Polubione utwory"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                        <TableView fx:id="likedSongsTable" prefHeight="240"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                        <Label text="Polubione wydania"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                        <TableView fx:id="likedReleasesTable" prefHeight="240"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- FOLLOWS -->
            <Tab text="Obserwowani">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <VBox spacing="12">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="Obserwowani"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <HBox spacing="8">
                            <Button fx:id="refreshFollowsBtn" text="⟳  Odśwież" onAction="#loadFollows"
                                    style="-fx-background-color: #1db954; -fx-text-fill: white;
                                           -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-padding: 7 16 7 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </HBox>
                        <Label text="Obserwowani artyści"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                        <TableView fx:id="followedArtistsTable" prefHeight="200"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                        <Label text="Obserwowani użytkownicy"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                        <TableView fx:id="followedUsersTable" prefHeight="200"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                        <Label text="Obserwujący mnie"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                        <TableView fx:id="followersTable" prefHeight="200"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- STATS -->
            <Tab text="Statystyki">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <VBox spacing="12">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="Statystyki"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <HBox spacing="12" alignment="CENTER_LEFT"
                              style="-fx-background-color: white; -fx-background-radius: 8;
                                     -fx-border-color: #dde1e7; -fx-border-radius: 8; -fx-padding: 12;">
                            <Label text="Od:" style="-fx-text-fill: #333; -fx-font-size: 13px;"/>
                            <DatePicker fx:id="statsFrom" promptText="od"
                                        style="-fx-background-color: #f8f9fa;"/>
                            <Label text="Do:" style="-fx-text-fill: #333; -fx-font-size: 13px;"/>
                            <DatePicker fx:id="statsTo" promptText="do"
                                        style="-fx-background-color: #f8f9fa;"/>
                            <Button fx:id="loadStatsBtn" text="Załaduj" onAction="#loadStats"
                                    style="-fx-background-color: #1db954; -fx-text-fill: white; -fx-font-weight: bold;
                                           -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-padding: 7 20 7 20; -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </HBox>
                        <HBox fx:id="statsCards" spacing="12" alignment="CENTER_LEFT"/>
                        <Label text="Top Utwory"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                        <TableView fx:id="topSongsTable" prefHeight="200"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                        <Label text="Top Artyści"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                        <TableView fx:id="topArtistsTable" prefHeight="200"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                        <Label text="Top Wydania"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                        <TableView fx:id="topReleasesTable" prefHeight="200"
                                   style="-fx-background-color: white; -fx-border-color: #dde1e7;
                                          -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ACCOUNT -->
            <Tab text="Konto">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <VBox spacing="12">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="Moje konto"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <VBox fx:id="profileBox" spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 8;
                                     -fx-border-color: #dde1e7; -fx-border-radius: 8; -fx-padding: 18;"/>
                        <Label text="Akcje Spotify"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                        <HBox spacing="10">
                            <Button text="Odśwież token Spotify" onAction="#handleRefreshSpotify"
                                    style="-fx-background-color: #f8f9fa; -fx-text-fill: #333;
                                           -fx-border-color: #ced4da; -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button text="Synchronizuj streamy" onAction="#handleSyncStreams"
                                    style="-fx-background-color: #1db954; -fx-text-fill: white; -fx-font-weight: bold;
                                           -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </HBox>
                        <TextArea fx:id="accountResponse" prefRowCount="6" editable="false"
                                  style="-fx-background-color: #f8f9fa; -fx-text-fill: #222;
                                         -fx-font-family: monospace; -fx-font-size: 12px;
                                         -fx-border-color: #dde1e7; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                    </VBox>
                </ScrollPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
