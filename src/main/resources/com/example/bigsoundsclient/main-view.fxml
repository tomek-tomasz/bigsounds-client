<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bigsoundsclient.ui.main.MainController"
            style="-fx-background-color: #f0f2f5;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: white; -fx-border-color: #dde1e7; -fx-border-width: 0 0 1 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Label text="🎵 BigSounds"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1db954;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" text=""
                   style="-fx-text-fill: #555; -fx-font-size: 13px;"/>
            <Button text="Wyloguj" onAction="#handleLogout"
                    style="-fx-background-color: #f8f9fa; -fx-text-fill: #333;
                           -fx-border-color: #ced4da; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: #f0f2f5; -fx-tab-min-width: 90px;">

            <Tab text="Utwory">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="songs" source="songs-view.fxml"/>
                </ScrollPane>
            </Tab>

            <Tab text="Wydania">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="releases" source="releases-view.fxml"/>
                </ScrollPane>
            </Tab>

            <Tab text="Artyści">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="artists" source="artists-view.fxml"/>
                </ScrollPane>
            </Tab>

            <Tab text="Playlisty">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="playlists" source="playlists-view.fxml"/>
                </ScrollPane>
            </Tab>

            <Tab text="Polubienia">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="likes" source="likes-view.fxml"/>
                </ScrollPane>
            </Tab>

            <Tab text="Obserwowani">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="follows" source="follows-view.fxml"/>
                </ScrollPane>
            </Tab>

            <Tab text="Statystyki">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="stats" source="stats-view.fxml"/>
                </ScrollPane>
            </Tab>

            <Tab text="Historia">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="history" source="history-view.fxml"/>
                </ScrollPane>
            </Tab>

            <Tab text="Użytkownicy">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="users" source="users-view.fxml"/>
                </ScrollPane>
            </Tab>

            <Tab text="Rekomendacje">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="recommendations" source="recommendations-view.fxml"/>
                </ScrollPane>
            </Tab>

            <Tab text="Feed">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="feed" source="feed-view.fxml"/>
                </ScrollPane>
            </Tab>

            <Tab text="Konto">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
                    <fx:include fx:id="account" source="account-view.fxml"/>
                </ScrollPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
