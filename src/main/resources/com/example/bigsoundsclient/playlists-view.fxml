<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.bigsoundsclient.PlaylistsController"
      spacing="12" style="-fx-background-color: #f0f2f5;">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Moje Playlisty"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>

    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-background-radius: 8;
                 -fx-border-color: #dde1e7; -fx-border-radius: 8; -fx-padding: 12;">
        <TextField fx:id="newPlaylistName" promptText="Nazwa nowej playlisty" prefWidth="240"
                   style="-fx-background-color: #f8f9fa; -fx-text-fill: #222;
                          -fx-prompt-text-fill: #aaa; -fx-border-color: #ced4da;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-padding: 7 12 7 12; -fx-font-size: 13px;"/>
        <CheckBox fx:id="newPlaylistPrivate" text="Prywatna"
                  style="-fx-text-fill: #333; -fx-font-size: 13px;"/>
        <Button fx:id="createPlaylistBtn" text="+ Utwórz" onAction="#createPlaylist"
                style="-fx-background-color: #1db954; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-border-radius: 6; -fx-background-radius: 6;
                       -fx-padding: 7 18 7 18; -fx-cursor: hand; -fx-font-size: 12px;"/>
        <Button fx:id="refreshPlaylistsBtn" text="⟳  Odśwież" onAction="#loadPlaylists"
                style="-fx-background-color: #f8f9fa; -fx-text-fill: #333;
                       -fx-border-color: #ced4da; -fx-border-radius: 6; -fx-background-radius: 6;
                       -fx-padding: 7 16 7 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
    </HBox>

    <TableView fx:id="playlistsTable" prefHeight="300"
               style="-fx-background-color: white; -fx-border-color: #dde1e7;
                      -fx-border-radius: 8; -fx-background-radius: 8;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="playlistSongsLabel" text=""
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1db954;" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="addSongIdField" promptText="ID utworu" prefWidth="110"
                   style="-fx-background-color: #f8f9fa; -fx-text-fill: #222;
                          -fx-prompt-text-fill: #aaa; -fx-border-color: #ced4da;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-padding: 6 10 6 10; -fx-font-size: 13px;"
                   visible="false" managed="false"/>
        <Button fx:id="addSongBtn" text="+ Dodaj utwór" onAction="#addSongToPlaylist"
                style="-fx-background-color: #1db954; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-border-radius: 6; -fx-background-radius: 6;
                       -fx-padding: 6 14 6 14; -fx-cursor: hand; -fx-font-size: 12px;"
                visible="false" managed="false"/>
    </HBox>

    <TableView fx:id="playlistSongsTable" prefHeight="260"
               style="-fx-background-color: white; -fx-border-color: #dde1e7;
                      -fx-border-radius: 8; -fx-background-radius: 8;"
               visible="false" managed="false"/>
</VBox>
